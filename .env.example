# ---------------------------------------------------------------------------
# AFTR backend (Spring Boot) — environment variables. Copy values into your
# shell, IDE run configuration, or a backend/.env loader. Never commit secrets.
# ---------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/aftr
DATABASE_USERNAME=aftr
DATABASE_PASSWORD=change-me

# Comma-separated origins allowed to call the API with cookies (the React app).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set to true behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# Seed the demo dataset on first start (only when the users table is empty).
SEED_DEMO_DATA=true

# No payment provider is integrated. When true, paid tickets go through a clearly
# labelled development checkout (recorded as SIMULATED_PAID, never as revenue).
# When false, paid checkout is refused with HTTP 503.
DEV_CHECKOUT_ENABLED=true

# Where uploaded cover images and avatars are stored.
UPLOAD_DIR=./uploads

# Integration tests (mvn verify) use a separate database.
TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/aftr_test
TEST_DATABASE_USERNAME=aftr
TEST_DATABASE_PASSWORD=change-me
