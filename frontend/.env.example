# Base URL of the Spring Boot API. Leave empty in development: Vite proxies /api to the backend.
# For a separately hosted frontend, set e.g. https://api.example.com (and add this origin to CORS_ALLOWED_ORIGINS).
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api and /uploads.
VITE_DEV_BACKEND_URL=http://localhost:8080
# Show the demo-account helper on the sign-in page (development only).
VITE_SHOW_DEMO_ACCOUNTS=true
